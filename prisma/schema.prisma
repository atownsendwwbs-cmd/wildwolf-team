// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
}

model User {
  id        String   @id @default(cuid())
  name      String
  pinHash   String?
  role      Role     @default(EMPLOYEE)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  briefs        DailyBrief[]
  alertsFiled   InventoryAlert[] @relation("AlertFiledBy")
  alertsResolved InventoryAlert[] @relation("AlertResolvedBy")
  eodReports    EndOfDayReport[]
}

enum Lang {
  EN
  ES
}

model DailyBrief {
  id           String   @id @default(cuid())
  date         DateTime @default(now())
  sourceLang   Lang     @default(EN)
  titleEn      String
  titleEs      String
  // Quick overview of the day
  introEn      String
  introEs      String
  // JSON-encoded per-sales-channel breakdown: { tiktok, amazon, faire, whatnot, other }
  productionEn String
  productionEs String
  // Order packing announcements: what's low, what to watch, new products
  packingEn    String
  packingEs    String
  // Special projects, important announcements and reminders
  specialEn    String
  specialEs    String
  translated   Boolean  @default(true)
  authorId     String
  author       User     @relation(fields: [authorId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([date])
}

enum InventoryCategory {
  FINISHED_GOOD
  RAW_MATERIAL
  SUPPLY
}

enum Urgency {
  LOW
  MEDIUM
  HIGH
}

enum AlertStatus {
  OPEN
  RESOLVED
}

model InventoryAlert {
  id         String            @id @default(cuid())
  category   InventoryCategory
  itemName   String
  notes      String?
  urgency    Urgency           @default(MEDIUM)
  status     AlertStatus       @default(OPEN)
  reportedById String
  reportedBy   User            @relation("AlertFiledBy", fields: [reportedById], references: [id])
  resolvedById String?
  resolvedBy   User?           @relation("AlertResolvedBy", fields: [resolvedById], references: [id])
  resolvedAt DateTime?
  createdAt  DateTime          @default(now())

  @@index([status])
  @@index([category])
}

model EndOfDayReport {
  id           String   @id @default(cuid())
  date         DateTime @default(now())
  authorId     String
  author       User     @relation(fields: [authorId], references: [id])
  packedItems  String
  sortedOutItems String
  notes        String?
  leftOff      String?
  createdAt    DateTime @default(now())

  @@index([date])
}
