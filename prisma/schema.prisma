// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
}

model User {
  id            String      @id @default(cuid())
  name          String
  pinHash       String?
  role          Role        @default(EMPLOYEE)
  preferredLang Lang        @default(EN)
  active        Boolean     @default(true)
  departmentId  String?
  department    Department? @relation(fields: [departmentId], references: [id])
  createdAt     DateTime    @default(now())

  briefs            DailyBrief[]
  alertsFiled       InventoryAlert[]   @relation("AlertFiledBy")
  alertsResolved    InventoryAlert[]   @relation("AlertResolvedBy")
  eodReports        EndOfDayReport[]
  pushSubscriptions PushSubscription[]
  tasksAssigned     Task[]             @relation("TaskAssignedTo")
  tasksCreated      Task[]             @relation("TaskAssignedBy")
  announcements     Announcement[]
  reactions         Reaction[]
  directives        Directive[]        @relation("DirectivesForUser")
  directivesWritten Directive[]        @relation("DirectivesCreatedBy")
  projects          SpecialProject[]   @relation("ProjectsForUser")
  projectsCreated   SpecialProject[]   @relation("ProjectsCreatedBy")

  @@index([departmentId])
}

// Non-person-specific task categories (e.g. Production, Labels, Bag
// Labeling) — a task can be assigned to a whole department instead of
// (or as well as having) a specific person, and a team member can belong
// to one so department-wide tasks show up as "mine" for them.
model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  tasks Task[]
  users User[]
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

enum TaskStatus {
  OPEN
  DONE
}

model Task {
  id           String      @id @default(cuid())
  title        String
  details      String?
  // assignedToId, departmentId both null = assigned to everyone.
  // At most one of assignedToId / departmentId should be set.
  assignedToId String?
  assignedTo   User?       @relation("TaskAssignedTo", fields: [assignedToId], references: [id])
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  assignedById String
  assignedBy   User        @relation("TaskAssignedBy", fields: [assignedById], references: [id])
  status       TaskStatus  @default(OPEN)
  completedAt  DateTime?
  createdAt    DateTime    @default(now())

  @@index([status])
  @@index([assignedToId])
  @@index([departmentId])
}

model Announcement {
  id               String    @id @default(cuid())
  sourceLang       Lang      @default(EN)
  messageEn        String
  messageEs        String
  translated       Boolean   @default(true)
  // JSON-encoded array of userIds @mentioned in the message, so they can
  // get a distinct "you were mentioned" push on top of the usual one.
  mentionedUserIds String    @default("[]")
  authorId         String
  author           User      @relation(fields: [authorId], references: [id])
  createdAt        DateTime  @default(now())
  editedAt         DateTime?

  @@index([createdAt])
}

enum Lang {
  EN
  ES
}

model DailyBrief {
  id           String    @id @default(cuid())
  date         DateTime  @default(now())
  sourceLang   Lang      @default(EN)
  titleEn      String
  titleEs      String
  // Quick overview of the day
  introEn      String
  introEs      String
  // JSON-encoded per-sales-channel breakdown: { tiktok, amazon, faire, whatnot, other }
  productionEn String
  productionEs String
  // Order packing announcements: what's low, what to watch, new products
  packingEn    String
  packingEs    String
  // Special projects, important announcements and reminders
  specialEn    String
  specialEs    String
  translated   Boolean   @default(true)
  authorId     String
  author       User      @relation(fields: [authorId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  editedAt     DateTime?

  @@index([date])
}

enum InventoryCategory {
  FINISHED_GOOD
  RAW_MATERIAL
  SUPPLY
}

enum Urgency {
  LOW
  MEDIUM
  HIGH
}

enum AlertStatus {
  OPEN
  RESOLVED
}

enum AlertResolution {
  RESTOCKED
  DISCONTINUED
}

// Finished-goods stock tiers — how many units are left
enum StockLevel {
  UNDER_100
  UNDER_50
  UNDER_25
  OUT_OF_STOCK
}

// Raw materials skip urgency entirely: either we're out (highest priority)
// or we're low but still have material to pack with
enum RawMaterialStatus {
  OUT
  LOW
}

// The warehouse's standard box sizes (LxWxH, inches)
enum BoxSize {
  SIZE_8X6X6
  SIZE_12X12X12
  SIZE_14X9X9
  SIZE_14X12X10
  SIZE_15X15X15
  SIZE_16X12X12
  SIZE_24X16X16
  SIZE_36X12X16
  SIZE_24X20X20
  SIZE_24X16X12
}

model InventoryAlert {
  id                String             @id @default(cuid())
  category          InventoryCategory
  itemName          String
  notes             String?
  // SUPPLY only
  urgency           Urgency?
  boxSize           BoxSize?
  supplySize        String?
  // FINISHED_GOOD only
  stockLevel        StockLevel?
  // RAW_MATERIAL only — exact amount (e.g. "12 bags", "3 pallets", "450 lbs")
  rawMaterialStatus RawMaterialStatus?
  quantity          String?
  status            AlertStatus        @default(OPEN)
  // Why it was resolved -- restocked (back on the shelf) vs discontinued
  // (we're not carrying/making it anymore, so it shouldn't get reported
  // as low again). Null while OPEN.
  resolution        AlertResolution?
  reportedById      String
  reportedBy        User               @relation("AlertFiledBy", fields: [reportedById], references: [id])
  resolvedById      String?
  resolvedBy        User?              @relation("AlertResolvedBy", fields: [resolvedById], references: [id])
  resolvedAt        DateTime?
  createdAt         DateTime           @default(now())

  @@index([status])
  @@index([category])
}

model EndOfDayReport {
  id             String   @id @default(cuid())
  date           DateTime @default(now())
  authorId       String
  author         User     @relation(fields: [authorId], references: [id])
  packedItems    String
  sortedOutItems String
  notes          String?
  leftOff        String?
  createdAt      DateTime @default(now())

  @@index([date])
}

enum ReactionTarget {
  ANNOUNCEMENT
  BRIEF
  TASK
}

// Polymorphic emoji reactions — messageId points at an Announcement,
// DailyBrief, or Task id depending on messageType (no FK, since it can
// point at any of the three tables).
model Reaction {
  id          String         @id @default(cuid())
  messageType ReactionTarget
  messageId   String
  userId      String
  user        User           @relation(fields: [userId], references: [id])
  emoji       String
  createdAt   DateTime       @default(now())

  @@unique([messageType, messageId, userId, emoji])
  @@index([messageType, messageId])
}

// Admin-only, per-employee priority list. Always-current (not dated) --
// the Admin edits it in place as priorities shift, rather than posting a
// fresh entry every day. Only the assigned employee and Admins can see it.
model Directive {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation("DirectivesForUser", fields: [userId], references: [id])
  // Optional grouping label (e.g. "Morning Tasks", "Reporting") so a long
  // list reads like a structured job description instead of one flat list.
  // Null items render ungrouped, above any sections.
  section     String?
  text        String
  sortOrder   Int      @default(0)
  createdById String
  createdBy   User     @relation("DirectivesCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

enum ProjectStatus {
  OPEN
  DONE
}

// Admin-assigned special projects (replaces sending a Google Doc link) --
// longer-form than a Directive, with an optional due date, and the
// assigned employee can mark it done themselves.
model SpecialProject {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation("ProjectsForUser", fields: [userId], references: [id])
  title       String
  details     String?
  dueDate     DateTime?
  status      ProjectStatus @default(OPEN)
  completedAt DateTime?
  createdById String
  createdBy   User          @relation("ProjectsCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([userId])
  @@index([status])
}
