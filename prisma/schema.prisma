// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
}

model User {
  id            String   @id @default(cuid())
  name          String
  pinHash       String?
  role          Role     @default(EMPLOYEE)
  preferredLang Lang     @default(EN)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  briefs        DailyBrief[]
  alertsFiled   InventoryAlert[] @relation("AlertFiledBy")
  alertsResolved InventoryAlert[] @relation("AlertResolvedBy")
  eodReports    EndOfDayReport[]
  pushSubscriptions PushSubscription[]
  tasksAssigned  Task[] @relation("TaskAssignedTo")
  tasksCreated   Task[] @relation("TaskAssignedBy")
  announcements  Announcement[]
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

enum TaskStatus {
  OPEN
  DONE
}

model Task {
  id           String     @id @default(cuid())
  title        String
  details      String?
  // null = assigned to everyone
  assignedToId String?
  assignedTo   User?      @relation("TaskAssignedTo", fields: [assignedToId], references: [id])
  assignedById String
  assignedBy   User       @relation("TaskAssignedBy", fields: [assignedById], references: [id])
  status       TaskStatus @default(OPEN)
  completedAt  DateTime?
  createdAt    DateTime   @default(now())

  @@index([status])
  @@index([assignedToId])
}

model Announcement {
  id         String   @id @default(cuid())
  sourceLang Lang     @default(EN)
  messageEn  String
  messageEs  String
  translated Boolean  @default(true)
  authorId   String
  author     User     @relation(fields: [authorId], references: [id])
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

enum Lang {
  EN
  ES
}

model DailyBrief {
  id           String   @id @default(cuid())
  date         DateTime @default(now())
  sourceLang   Lang     @default(EN)
  titleEn      String
  titleEs      String
  // Quick overview of the day
  introEn      String
  introEs      String
  // JSON-encoded per-sales-channel breakdown: { tiktok, amazon, faire, whatnot, other }
  productionEn String
  productionEs String
  // Order packing announcements: what's low, what to watch, new products
  packingEn    String
  packingEs    String
  // Special projects, important announcements and reminders
  specialEn    String
  specialEs    String
  translated   Boolean  @default(true)
  authorId     String
  author       User     @relation(fields: [authorId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([date])
}

enum InventoryCategory {
  FINISHED_GOOD
  RAW_MATERIAL
  SUPPLY
}

enum Urgency {
  LOW
  MEDIUM
  HIGH
}

enum AlertStatus {
  OPEN
  RESOLVED
}

// Finished-goods stock tiers — how many units are left
enum StockLevel {
  UNDER_100
  UNDER_50
  UNDER_25
  OUT_OF_STOCK
}

// Raw materials skip urgency entirely: either we're out (highest priority)
// or we're low but still have material to pack with
enum RawMaterialStatus {
  OUT
  LOW
}

// The warehouse's standard box sizes (LxWxH, inches)
enum BoxSize {
  SIZE_8X6X6
  SIZE_12X12X12
  SIZE_14X9X9
  SIZE_14X12X10
  SIZE_15X15X15
  SIZE_16X12X12
  SIZE_24X16X16
  SIZE_36X12X16
  SIZE_24X20X20
  SIZE_24X16X12
}

model InventoryAlert {
  id                String             @id @default(cuid())
  category          InventoryCategory
  itemName          String
  notes             String?
  // SUPPLY only
  urgency           Urgency?
  boxSize           BoxSize?
  supplySize        String?
  // FINISHED_GOOD only
  stockLevel        StockLevel?
  // RAW_MATERIAL only — exact amount (e.g. "12 bags", "3 pallets", "450 lbs")
  rawMaterialStatus RawMaterialStatus?
  quantity          String?
  status            AlertStatus        @default(OPEN)
  reportedById      String
  reportedBy        User               @relation("AlertFiledBy", fields: [reportedById], references: [id])
  resolvedById      String?
  resolvedBy        User?              @relation("AlertResolvedBy", fields: [resolvedById], references: [id])
  resolvedAt        DateTime?
  createdAt         DateTime           @default(now())

  @@index([status])
  @@index([category])
}

model EndOfDayReport {
  id           String   @id @default(cuid())
  date         DateTime @default(now())
  authorId     String
  author       User     @relation(fields: [authorId], references: [id])
  packedItems  String
  sortedOutItems String
  notes        String?
  leftOff      String?
  createdAt    DateTime @default(now())

  @@index([date])
}
